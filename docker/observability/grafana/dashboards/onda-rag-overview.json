{
  "annotations": {"list": []},
  "editable": true,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "process_uptime_seconds{application=\"onda-agentic-rag\"}", "refId": "A"}],
      "title": "Application Uptime",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 9, "x": 6, "y": 0},
      "id": 2,
      "targets": [{"expr": "jvm_memory_used_bytes{application=\"onda-agentic-rag\",area=\"heap\"}", "legendFormat": "{{id}}", "refId": "A"}],
      "title": "JVM Heap Used",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 9, "x": 15, "y": 0},
      "id": 3,
      "targets": [{"expr": "sum(jvm_threads_live_threads{application=\"onda-agentic-rag\"})", "refId": "A"}],
      "title": "Live JVM Threads",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 8},
      "id": 4,
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{application=\"onda-agentic-rag\"}[5m]))", "legendFormat": "requests/s", "refId": "A"}],
      "title": "HTTP Request Rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 8},
      "id": 5,
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"onda-agentic-rag\"}[5m])))", "legendFormat": "p95", "refId": "A"}],
      "title": "HTTP p95 Latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 17},
      "id": 6,
      "targets": [{"expr": "hikaricp_connections_active{application=\"onda-agentic-rag\"}", "legendFormat": "active", "refId": "A"}, {"expr": "hikaricp_connections_idle{application=\"onda-agentic-rag\"}", "legendFormat": "idle", "refId": "B"}],
      "title": "Database Connections",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 17},
      "id": 7,
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{application=\"onda-agentic-rag\",outcome=~\"SERVER_ERROR|CLIENT_ERROR\"}[5m])) / sum(rate(http_server_requests_seconds_count{application=\"onda-agentic-rag\"}[5m]))", "legendFormat": "error ratio", "refId": "A"}],
      "title": "HTTP Error Ratio",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 41,
  "tags": ["onda", "observability"],
  "templating": {"list": []},
  "time": {"from": "now-15m", "to": "now"},
